<?xml version="1.0" encoding="utf-8"?>
<!-- AETHER launcher foreground, 108dp viewport.
     Original mark: wireless-signal arcs over a connected node, fused with an
     abstract letter-A / shield silhouette. All artwork stays inside the
     66dp-diameter safe circle centered at (54,54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer signal arc (electric cyan, upper hemisphere of the node). -->
    <path
        android:pathData="M42.69,26.69 A16,16 0 0 1 65.31,26.69"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#00E5CC"
        android:fillColor="#00000000" />

    <!-- Inner signal arc (electric cyan). -->
    <path
        android:pathData="M46.93,30.93 A10,10 0 0 1 61.07,30.93"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#00E5CC"
        android:fillColor="#00000000" />

    <!-- Connected node: solid circle. -->
    <path
        android:pathData="M49,38 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0 Z"
        android:fillColor="#00E5CC" />

    <!-- Link from the node down into the shield apex. -->
    <path
        android:pathData="M54,44 L54,50"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#00E5CC"
        android:fillColor="#00000000" />

    <!-- Shield / letter-A silhouette: bold triangle outline. -->
    <path
        android:pathData="M54,52 L37,81 L71,81 Z"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:strokeColor="#00E5CC"
        android:fillColor="#00000000" />

    <!-- Restrained blue crossbar of the A. -->
    <path
        android:pathData="M45.5,68 L62.5,68 L59.5,74 L48.5,74 Z"
        android:fillColor="#3D7BFF" />
</vector>
